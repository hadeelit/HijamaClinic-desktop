<UserControl x:Class="HijamaClinicManagement.SMSView.SMS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HijamaClinicManagement.SMSView"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White" FlowDirection="RightToLeft" Loaded="UserControl_Loaded">
    <!--Create window body -->
    <Grid x:Name="MainWindowBody" Grid.Row="1" FlowDirection="RightToLeft">
        <Grid  x:Name="SMSContent" Visibility="Visible" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!-- Header in Row1-->
            <TextBlock x:Name="HeaderForSMSContent" Grid.Row="0" Text="رسالة قصيرة SMS" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20" Foreground="#FF5D5D61" Padding="25,0,0,0"/>
            <!-- Create Fields in Row2-->
            <Grid Grid.Row="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel  Grid.Row="1" Grid.Column="0" Orientation="Vertical" Margin="0,50,0,0">
                    <StackPanel x:Name="Item1" Orientation="Horizontal">
                        <TextBlock   Text="رقم الجوال" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Foreground="#FF5D5D61" Padding="10,0,0,0" Margin="50,0,0,0"/>
                        <TextBox  x:Name="Number" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20" MinWidth="250" Height="30" Foreground="Black" MaxLength="10" Margin="80,0,0,0" Style="{DynamicResource TextBoxStyle}" PreviewTextInput="TextBox_PreviewTextInput" />
                    </StackPanel>
                    <StackPanel x:Name="Item2" Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock   Text="محتوى الرسالة" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Foreground="#FF5D5D61" Padding="10,0,0,0" Margin="50,20,0,0"/>
                        <TextBox   x:Name="Message"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20" Width="270" Height="60" Foreground="Black" FlowDirection="RightToLeft" TextWrapping="Wrap" Margin="50,0,0,0" Style="{DynamicResource TextBoxStyle}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" Margin="0,50,0,0">
                    <Button x:Name="Send_SMS"   IsEnabled="True"     Content="ارسال"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai"  FontSize="16" Height="40" MaxWidth="250"  Margin="3"  BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="Send_SMS_Click"/>
                    <Button x:Name="Check_Balance" IsEnabled="True"  Content="الرصيد"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Height="40" MaxWidth="250"  Margin="3"  BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="Check_Balance_Click"/>
                    <Button x:Name="Clear"           Content="مسح"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai"    FontSize="16" Height="40" MaxWidth="250"  Margin="3"  BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="Clear_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
