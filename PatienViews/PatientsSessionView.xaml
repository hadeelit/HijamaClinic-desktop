                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <!-- Item7-->
                        <TextBlock x:Name="Cva_PMH" Text="الجلطات الدماغية"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF5D5D61"/>
                        <CheckBox x:Name="Cva_You" VerticalAlignment="Center" Margin="65,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <CheckBox x:Name="Cva_Family" VerticalAlignment="Center" Margin="60,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <!-- Item8-->
                        <TextBlock x:Name="Tb_PMH" Text="الدرن"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center"  Foreground="#FF5D5D61" Margin="70,0,0,0"/>
                        <CheckBox x:Name="Tb_You" VerticalAlignment="Center" Margin="117,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <CheckBox x:Name="Tb_Family" VerticalAlignment="Center" Margin="60,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <!-- Item9-->
                        <TextBlock x:Name="Epilepsy_PMH" Text="الصرع"   FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF5D5D61"/>
                        <CheckBox x:Name="Epilepsy_You" VerticalAlignment="Center" Margin="138,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <CheckBox x:Name="Epilepsy_Family" VerticalAlignment="Center" Margin="61,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <!-- Item10-->
                        <TextBlock x:Name="Kidney_PMH" Text="أمراض بالكلى"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center"  Foreground="#FF5D5D61" Margin="70,0,0,0"/>
                        <CheckBox x:Name="Kidney_You" VerticalAlignment="Center" Margin="67,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <CheckBox x:Name="Kidney_Family" VerticalAlignment="Center" Margin="59,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <!-- Item11-->
                        <TextBlock x:Name="PsychiatricD_PMH" Text="أمراض نفسية"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF5D5D61"/>
                        <CheckBox x:Name="PsychiatricD_You" VerticalAlignment="Center" Margin="84,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <CheckBox x:Name="PsychiatricD_Family" VerticalAlignment="Center" Margin="60,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <!-- Item12-->
                        <TextBlock x:Name="Cancer_PMH" Text="السرطان"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center"  Foreground="#FF5D5D61" Margin="70,0,0,0"/>
                        <CheckBox x:Name="Cancer_You" VerticalAlignment="Center" Margin="94,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <CheckBox x:Name="Cancer_Family" VerticalAlignment="Center" Margin="59,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <!-- Item13-->
                        <TextBlock x:Name="Anemia_PMH" Text="فقر الدم أو الأنيميا"   FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF5D5D61"/>
                        <CheckBox x:Name="Anemia_You" VerticalAlignment="Center" Margin="60,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <CheckBox x:Name="Anemia_Family" VerticalAlignment="Center" Margin="60,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                        <!-- Item14-->
                        <TextBlock x:Name="Smoking_PMH" Text="التدخين"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center"  Foreground="#FF5D5D61" Margin="70,0,0,0"/>
                        <CheckBox x:Name="Smoking_You" VerticalAlignment="Center" Margin="107,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" >
                        <!-- Item15-->
                        <TextBlock x:Name="Others_PMH" Text="عادات اجتماعية أخرى"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF5D5D61"/>
                        <CheckBox x:Name="Others_You" VerticalAlignment="Center" Margin="42,0,0,0" Style="{DynamicResource ShowHidePassCheckBoxStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Create DataView From Patient and SessionTable in Row3-->
            <DataGrid Grid.Row="2" x:Name="DataGv_PMedicalH" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" Style="{DynamicResource DataGridStyle}" MouseDoubleClick="DataGv_PMedicalH_MouseDoubleClick" Margin="0,10,0,0">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                   Color="#61CE70"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn  Width="150"  Header="رقم السجل" Binding="{Binding SessionId}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="150"  Header="تاريخ الجلسة" Binding="{Binding Path=SessionDate , StringFormat='dd-MM-yyyy'}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="150"  Header="رقم الجلسة"  Binding="{Binding SessionNum}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="رقم سجل التاريخ المرضي السابق"  Binding="{Binding PastMedicalHistoryId}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="أمراض بالدم والسيولة"  Binding="{Binding BleedingDisorders}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="ارتفاع ضغط الدم"  Binding="{Binding Hypertension}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="أمراض القلب"  Binding="{Binding CardiacDiseases}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="مرض السكري"  Binding="{Binding Diabetes}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="الالتهاب الكبدي"  Binding="{Binding HepAtitis}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="الإيدز"  Binding="{Binding Aids}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="الجلطات الدماغية"  Binding="{Binding Cva}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="الدرن"  Binding="{Binding Tb}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="الصرع"  Binding="{Binding Epilepsy}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="أمراض بالكلى"  Binding="{Binding KidneyDiseases}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="أمراض نفسية"  Binding="{Binding PsychiatricDiseases}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="السرطان"  Binding="{Binding Cancer}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="فقر الدم أو الأنيميا"  Binding="{Binding Anemia}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="التدخين"  Binding="{Binding Smoking}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="*"  Header="أخرى"  Binding="{Binding Others}" Foreground="#FF5D5D61"/>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Disclaimer Form View-->
        <Grid   x:Name="Accept_FormContent" Visibility="Hidden"  Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition  Height="auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <!-- Headerin Row 0-->
            <StackPanel Grid.Row="0" Orientation="Horizontal" >
                <TextBlock Text="معلومات المريض:" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <StackPanel   Orientation="Horizontal"   HorizontalAlignment="Stretch" Margin="0,0,0,0">
                    <TextBlock   Text="رقم الملف" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai"  HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,0,0" Foreground="#FF5D5D61" Padding="3,0,0,0"/>
                    <TextBox Width="160" IsReadOnly="True" Height="24" x:Name="DiscFormFileNumField"  Foreground="Black" Padding="0,5" Margin="5,0,0,0" Style="{DynamicResource TextBoxStyle}"/>
                </StackPanel>
                <StackPanel  Orientation="Horizontal" Margin="0,0"  HorizontalAlignment="Stretch">
                    <TextBlock   Text="رقم الجلسة" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai"  HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,0,0" Foreground="#FF5D5D61" Padding="3,0,0,0"/>
                    <TextBox Width="160" IsReadOnly="True" Height="24" x:Name="DiscFormSNumField"  FlowDirection="RightToLeft" Margin="5,0,0,0"  Foreground="Black"   Style="{DynamicResource TextBoxStyle}"/>
                </StackPanel>
                <StackPanel  Orientation="Horizontal" Margin="0,0"  HorizontalAlignment="Stretch">
                    <TextBlock   Text="رقم السجل" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai"  HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,0,0" Foreground="#FF5D5D61" Padding="3,0,0,0"/>
                    <TextBox Width="160" IsReadOnly="True" Height="24" x:Name="DiscFormNumField"  FlowDirection="RightToLeft" Margin="5,0,0,0" Foreground="Black"  Style="{DynamicResource TextBoxStyle}"/>
                </StackPanel>
            </StackPanel>
            <!--Row 1 -->
            <Grid Grid.Row="1" x:Name="DisclaimerForm_Content" FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!-- Buttons in Col 1-->
                <StackPanel Grid.Column="1"  Orientation="Vertical" Margin="0,10,0,0">
                    <Button x:Name="AddButton_DiscForm" IsEnabled="False"  Content="اضافة"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Height="40" MaxWidth="250"  Margin="3" BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="AddButton_DiscForm_Click"/>
                    <Button x:Name="DeleteButton_DiscForm" IsEnabled="False"  Content="حذف"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Height="40" MaxWidth="250"  Margin="3" BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="DeleteButton_DiscForm_Click"/>
                    <Button x:Name="Print_DiscForm" Visibility="Hidden"  Content="طباعة"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Height="40" MaxWidth="250"  Margin="3" BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="Print_DiscForm_Click"/>
                </StackPanel>
                <!-- Body in Row1 col0-->
                <StackPanel Orientation="Vertical">
                        <TextBlock Text="موافقة/ اخلاء مسؤولية " FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Foreground="#FF5D5D61" Margin="0,10,0,5"/>
                    <TextBlock Text="أنا الموقع أدناه:" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="0,0,0,5"/>
                    <TextBlock Text="بهذا أفوض و أوافق على أن تجرى لي الحجامة من قبل أو تحت  اشراف طبيب المركز      د.  " FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="0,0,0,5"/>
                    <TextBlock Text="وقد أوضح لي الطبيب مرضي ومعالجته ، والمعالجة البديلة (إن وجدت) وطبيعتها والمخاطر "   FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="0,0,0,5"/>
                    <TextBlock Text="المتعلقة بها وإني أدرك أنه ليس بإمكان الطبيب أو المنشأة الصحية ضمان أي نتائج للمعالجة"   FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="0,0,0,5"/>
                    <TextBlock Text=" كذلك أعلم بأن لدي القدرة لوقف جلسة العلاج في أي وقت ،كما أعطي الحق في استخدام "   FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="0,0,0,5"/>
                    <TextBlock Text=" البيانات الطبية لحالتي لغرض الاحصاءات ."   FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="التوقيع:"   FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="0,10,0,10"/>
                        <TextBlock Text="البصمة :"  Width="60" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="270,10,0,10" VerticalAlignment="Center"/>
                        <Image x:Name="PrintImg" Width="200" Visibility="Visible" Margin="0,10,0,10"/>
                    </StackPanel>
                    <TextBlock Text="توقيع الطبيب مؤكداً الحصول على موافقة المريض على الخضوع للمعالجة المذكورة أعلاه :" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الاسم:" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16"/>
                        <TextBlock Text="التوقيع:" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="190,0,0,0"/>
                        <TextBlock Text="التاريخ:" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Margin="190,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Create DataView From Patient and SessionTable in Row3-->
            <DataGrid Grid.Row="2" x:Name="DataGv_DiscForm" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" 
                Style="{DynamicResource DataGridStyle}" MouseDoubleClick="DataGv_DiscForm_MouseDoubleClick" Margin="0,15,0,0">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                   Color="#61CE70"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn  Width="150"  Header="رقم السجل" Binding="{Binding SessionId}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="150"  Header="تاريخ الجلسة" Binding="{Binding Path=SessionDate , StringFormat='dd-MM-yyyy'}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="150"  Header="رقم الجلسة"  Binding="{Binding SessionNum}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="150"  Header="رقم سجل نموذج الموافقة المستنيرة"  Binding="{Binding DisclaimerFormId}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="*"  Header="البصمة"  Binding="{Binding PrintImg}" Foreground="#FF5D5D61"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        
    </Grid>
</UserControl>
