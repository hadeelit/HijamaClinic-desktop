<Window x:Class="HijamaClinicManagement.MessageBoxRestyle.MessageBoxInformation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:HijamaClinicManagement.MessageBoxRestyle"
        mc:Ignorable="d"
        Title="MessageBoxInformation" Height="300" Width="500" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True" WindowStyle="None" ResizeMode="NoResize" MouseDown="Window_MouseDown" Background="#FFE0E0E0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <!-- close Icon in Row1-->
        <StackPanel Grid.Row="0" Background="#76B82A">
            <materialDesign:PackIcon Grid.Row="0" x:Name="CloseIcon" Kind="Close" HorizontalAlignment="Left" VerticalAlignment="Center" Height="26" Width="32" Foreground="White" MouseDown="CloseIcon_MouseDown" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBlock Grid.Row="1" Text="نحن مجموعة من المهووسين الرقميين و لدينا سنوات عديدة من الخبرة في الوسائط الرقمية" TextAlignment="Right" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="13" Margin="10"/>
            <TextBlock Grid.Row="1" Text="بخبرة طويلة و دافع كبير، نحن دائما قادرون على إتخاذ القرارات الصحيحة لعملائنا نحن نضمن أن" TextAlignment="Right" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="13" Margin="10"/>
            <TextBlock Grid.Row="1" Text="استثمارات عملائنا تحصل على عائد إيجابي يتماشى مع توقعاتنا المشتركة . نحن نتابع باستمرار" TextAlignment="Right" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="13" Margin="10"/>
            <TextBlock Grid.Row="1" Text=".مشاريع عملائنا للتأكد من وصولنا إلى الأهداف الموضوعة مسبقاً" TextAlignment="Right" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="13" Margin="10"/>
        </StackPanel>
        <!-- Create Buttons-->
        <Button Grid.Row="2" x:Name="Ok"   Content="موافق"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Height="40" MaxWidth="250"  Margin="3" BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="Ok_Click"/>
    </Grid>
</Window>
