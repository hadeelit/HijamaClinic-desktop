<UserControl x:Class="HijamaClinicManagement.ReportsViews.DailyIncom"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HijamaClinicManagement.ReportsViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White" FlowDirection="RightToLeft" Loaded="UserControl_Loaded">
    <!-- Daily Bill Data View-->
    <Grid   x:Name="DailyBill_Content" Visibility="Visible" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" >
            <TextBlock Text="مجموع الدخل اليومي لتاريخ : " FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="190,0,0,0" />
            <TextBlock x:Name="datenow" Text=" تاريخ اليوم "  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" x:Name="Billd_Grid" FlowDirection="LeftToRight">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <!-- Header Table-->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="إجمالي المبالغ نقدياً" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text=" إجمالي المبالغ شبكة "  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="الإجمالي"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Top"/>
            <!-- Contents Table-->
            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="tbc" Text="القيمة" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="tbn" Text="القيمة"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="tbt" Text="القيمة"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Center"/>

        </Grid>
    </Grid>
</UserControl>
