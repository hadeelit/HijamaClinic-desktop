<Window x:Class="HijamaClinicManagement.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HijamaClinicManagement"
        mc:Ignorable="d"
        Title="SplashScreen" Height="350" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Images/4.png"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="206*"/>
            <RowDefinition Height="109*"/>
            <RowDefinition Height="85*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="arabictext" Grid.Row="0" Foreground="White" TextWrapping="Wrap" Text="FastMedia" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="36" Margin="0,120,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!--create row3 -->
        <ProgressBar x:Name="loadingprogressbar" Width="200" Margin="156,8,156,53" Grid.Row="2"  Foreground="White" BorderThickness="20,20,20,20" Orientation="Horizontal" FlowDirection="RightToLeft" />

    </Grid>
</Window>
