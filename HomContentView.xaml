<UserControl x:Class="HijamaClinicManagement.HomContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HijamaClinicManagement.PatienViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White" FlowDirection="RightToLeft" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <!--Restyle syncfusion:GridHeaderCellControl-->
        <Style TargetType="syncfusion:GridHeaderCellControl" x:Key="headerStyle">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="/WpfSideNav;component/Resources/Font/#Almarai"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Width" Value="auto"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <!--Restyle syncfusion:CellControl-->
        <Style TargetType="syncfusion:GridCell" x:Key="customCellStyle">
            <Setter Property="Padding" Value="0,20,0,0" />
        </Style>
    </UserControl.Resources>
    <!--Content Body for Main Page-->
    <Grid Grid.Row="2" x:Name="UCBodyContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="130" x:Name="row1"/>
            <RowDefinition Height="130" x:Name="row2"/>
            <RowDefinition Height="*" x:Name="row3"/>
        </Grid.RowDefinitions>

        <!-- View statistics about all patients , staff,and reports in one panel at Row 1-->
        <Grid Grid.Row="0" x:Name="statistics">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!--Patients-->
            <Border BorderThickness="1" Grid.Column="0" CornerRadius="10" Background="Transparent" BorderBrush="#D0D0D0"  Margin="10,10,0,0" >
                <Grid x:Name="all_patients" Background="Transparent" >
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/HijamaClinicManagement;component/Images/account-circle-custom (2).png"  Stretch="Fill"/>
                        <Label   Content="المرضى" FontSize="16" Padding="10,0,0,0" Foreground="#D0D0D0" VerticalAlignment="Center"  HorizontalAlignment="Center"  Background="White" FontFamily="/WpfSideNav;component/Resources/Font/#Almarai"/>
                    </StackPanel>
                    <Label x:Name="CountPatients" Grid.Row="1" Content="المرضى" FontSize="20"  Foreground="Black" VerticalAlignment="Center"  HorizontalAlignment="Center"  FontFamily="/WpfSideNav;component/Resources/Font/#Almarai" />
                </Grid>
            </Border>
            <!--Staff-->
            <Border BorderThickness="1" Grid.Column="1" CornerRadius="10" Background="Transparent" BorderBrush="#D0D0D0"  Margin="10,10,0,0" >
                <Grid x:Name="all_Staff" Background="Transparent" >
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/HijamaClinicManagement;component/images/account-supervisor-circle-custom (2).png" Stretch="Fill"/>
                        <Label   Content="المستخدمين " FontSize="16" Padding="10,0,0,0" Foreground="#D0D0D0" VerticalAlignment="Center"  HorizontalAlignment="Center"  Background="White" FontFamily="/WpfSideNav;component/Resources/Font/#Almarai"/>
                    </StackPanel>
                    <Label x:Name="Count_Users" Grid.Row="1" Content="المستخدمين" FontSize="20"  Foreground="Black" VerticalAlignment="Center"  HorizontalAlignment="Center"  FontFamily="/WpfSideNav;component/Resources/Font/#Almarai" />
                </Grid>
            </Border>
            <!--Reports-->
            <Border BorderThickness="1" Grid.Column="2" CornerRadius="10" Background="Transparent" BorderBrush="#D0D0D0"  Margin="10,10,10,0" >
                <Grid x:Name="all_reports" Background="Transparent" >
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/HijamaClinicManagement;component/images/pencil-circle-custom (2).png"  Stretch="Fill"/>
                        <Label   Content="الحجوزات " FontSize="16" Padding="10,0,0,0" Foreground="#D0D0D0" VerticalAlignment="Center"  HorizontalAlignment="Center"  Background="White" FontFamily="/WpfSideNav;component/Resources/Font/#Almarai"/>
                    </StackPanel>
                    <Label x:Name="CountAppointments" Grid.Row="1" Content="الحجوزات" FontSize="20"  Foreground="Black" VerticalAlignment="Center"  HorizontalAlignment="Center"  FontFamily="/WpfSideNav;component/Resources/Font/#Almarai" />
                </Grid>
            </Border>
        </Grid>

        <!-- View Quick actions for users like create new patient file - create new appointment and send sms in one panel at Row 2-->
        <Grid x:Name="quickbuttons" Grid.Row="1" Margin="0,20,0,0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border x:Name="NewPatient" BorderThickness="1" Grid.Column="0" CornerRadius="10" Background="#f8f8f8" BorderBrush="#D0D0D0"  Margin="10,0,0,0">
                <Grid x:Name="create_patientfile" Background="Transparent" >
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Label  Grid.Row="1" Content="+" FontSize="30"  Foreground="#C0C0C0" VerticalAlignment="Top"  HorizontalAlignment="Center" MouseDown="NewPatient_MouseDown"/>
                    </StackPanel>
                    <Label Grid.Row="1" Content="مريض جديد" FontSize="20"  Foreground="Black" VerticalAlignment="Top"  HorizontalAlignment="Center"  FontFamily="/WpfSideNav;component/Resources/Font/#Almarai" MouseDown="NewPatient_MouseDown" />
                </Grid>
            </Border>
            <Border x:Name="NewSession" BorderThickness="1" Grid.Column="1" CornerRadius="10" Background="#f8f8f8" BorderBrush="#D0D0D0"  Margin="10,0,0,0" >
                <Grid x:Name="create_sessionpatient" Background="Transparent" >
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Label  Grid.Row="1" Content="+" FontSize="30"  Foreground="#C0C0C0" VerticalAlignment="Center"  HorizontalAlignment="Center" MouseDown="NewSession_MouseDown"/>
                    </StackPanel>
                    <Label  Grid.Row="1" Content="جلسة جديدة" FontSize="20"  Foreground="Black" VerticalAlignment="Top"  HorizontalAlignment="Center"  FontFamily="/WpfSideNav;component/Resources/Font/#Almarai" MouseDown="NewSession_MouseDown" />
                </Grid>
            </Border>
            <Border x:Name="NewAppointment" BorderThickness="1" Grid.Column="2" CornerRadius="10" Background="#f8f8f8" BorderBrush="#D0D0D0"  Margin="10,0,10,0" >
                <Grid x:Name="create_newappointment" Background="Transparent" >
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Label  Grid.Row="1" Content="+" FontSize="30"  Foreground="#C0C0C0" VerticalAlignment="Center"  HorizontalAlignment="Center" MouseDown="NewAppointment_MouseDown"/>
                    </StackPanel>
                    <Label  Grid.Row="1" Content="موعد جديد" FontSize="20"  Foreground="Black" VerticalAlignment="Top"  HorizontalAlignment="Center"  FontFamily="/WpfSideNav;component/Resources/Font/#Almarai" MouseDown="NewAppointment_MouseDown" />
                </Grid>
            </Border>
        </Grid>

        <!-- View  all appointments on day in one panel at row 3-->
        <Border Grid.Row="2" x:Name="DGBorder" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="25" Margin="10,20,10,20">
            <Grid Grid.Row="2" x:Name="datagridappointment" Margin="10,10,10,20">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" >
                        <Image Source="/HijamaClinicManagement;component/images/calendar-account-custom_big.png" Width="40" Stretch="Fill"/>
                        <Label 
                                       Content=" حجوزات اليوم" 
                                       Margin="0,0,0,0"
                                       FontSize="18" 
                                       Padding="10,10,10,10"
                                       Foreground="Black" 
                                        FontWeight="Bold"
                                        VerticalAlignment="Top" 
                                        HorizontalAlignment="Left"  
                                        Background="White" FontFamily="/WpfSideNav;component/Resources/Font/#Almarai" />
                    </StackPanel>
                    <syncfusion:SfDataGrid x:Name="dataGrid"  
                                          ItemsSource="{Binding Orders}" 
                                          AutoGenerateColumns="False" Grid.Row="1" BorderBrush="Transparent" 
                                          Margin="10,10,10,20" AllowEditing="False"  
                                          AllowResizingColumns="True"  HeaderStyle="{StaticResource headerStyle}"
                                          GridLinesVisibility="None" ColumnSizer="Star" CellStyle="{StaticResource customCellStyle}">
                        <syncfusion:SfDataGrid.Columns >
                            <syncfusion:GridTextColumn  HeaderText="رقم السجل"  MappingName="OrderID" />
                            <syncfusion:GridTextColumn HeaderText="رقم الجوال" MappingName="CustomerID" />
                            <syncfusion:GridTextColumn HeaderText="اسم المريض" AllowFiltering="True" MappingName="CustomerName" />
                            <syncfusion:GridTextColumn HeaderText="تاريخ الحجز" MappingName="Country" />
                            <syncfusion:GridNumericColumn HeaderText="وقت الحجز" MappingName="UnitPrice" />
                            <syncfusion:GridNumericColumn  HeaderText="نوع الخدمة" MappingName="UnitPrice" />
                        </syncfusion:SfDataGrid.Columns>
                    </syncfusion:SfDataGrid>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
