<Window x:Class="HijamaClinicManagement.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HijamaClinicManagement"
        mc:Ignorable="d"
        Title="SplashScreen" Height="350" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" MouseDown="Window_MouseDown">
    <Grid>
        <!--create 3Rows-->
        <Grid.RowDefinitions>
            <RowDefinition Height="206*"/>
            <RowDefinition Height="109*"/>
            <RowDefinition Height="85*"/>
        </Grid.RowDefinitions>
        <!--create row1-->
        <Image x:Name="MainIcon" Grid.Row="0" Source="Images/mainIcon.png" Margin="217,18,217,36"/>
        <TextBlock x:Name="arabictext" Grid.Row="0" TextWrapping="Wrap" Text="إدارة مركز لمسة شفاء للحجامة" FontFamily="Andalus" FontSize="36" Margin="133,149,133,68" Grid.RowSpan="2" />
        <!--create row2-->
        <TextBlock x:Name="englishtext" Grid.Row="1" TextWrapping="Wrap" Text="Hijama LamsatShifaa Clinic Management " FontFamily="Century" FontSize="24" Margin="60,33,60,9" Foreground="#FF5D5D61"  />
        <!--create row3 -->
        <ProgressBar x:Name="loadingprogressbar" Width="200" Margin="156,8,156,53" Grid.Row="2"  Foreground="#76B82A" BorderThickness="20,20,20,20" Orientation="Horizontal" FlowDirection="RightToLeft" />
        
    </Grid>
</Window>
