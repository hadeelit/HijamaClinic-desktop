<Window x:Class="HijamaClinicManagement.Sign_in"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:HijamaClinicManagement"
        mc:Ignorable="d"
        Height="450" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" MouseDown="Window_MouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!-- Create Image For Right SideBar-->
        <Border Grid.Column="1" Margin="0,0,10,0">
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border CornerRadius="5" Height="100" Width="100" Background="White"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
            <!--Create image sidebar-->
            <Image Source="Images/4.png"/>
        </Border>
        <!--<TextBlock Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Text="FastMedia" Margin="0,0,0,70" FontSize="16"  Foreground="White" FontFamily="/WpfSideNav;component/Resources/Font/#Almarai"/>
        <TextBlock Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Text="Your best technical choice" Margin="0,0,0,50" FontSize="10" FontWeight="Light"  Foreground="White" FontFamily="/WpfSideNav;component/Resources/Font/#Almarai"/>-->
        <!-- Create Login Form For Left SideBar-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <!--Logo-->
           <!-- <Image Grid.Row="0" Source="Images/LogoFastMedia.png" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"  Margin="0,10,0,0"/>-->
            <materialDesign:PackIcon x:Name="CloseIcon" Kind="Close" HorizontalAlignment="Left" VerticalAlignment="Top" Height="27" Width="35" Margin="0,5,0,0" Foreground="#76B82A"  MouseDown="CloseIcon_MouseDown"/>
            <!--Create Form-->
            <Grid Grid.Row="1" Margin="60,50,60,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>
                <!--Create UserName Field in the Seconde Row-->
                <Label x:Name="usernamelable" FlowDirection="RightToLeft" Grid.Row="0"  Content="اسم المستخدم" Foreground="Black" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="14" Padding="0,14,0,0" Margin="0,6,0,0"/>
                <StackPanel  Orientation="Vertical" FlowDirection="RightToLeft">
                    <TextBox x:Name="UserName"  Grid.Row="0" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Height="20" MaxLength="20" BorderThickness="0" Padding="0,0,10,0" Margin="119,20,0,5" PreviewTextInput="UserName_PreviewTextInput" TextChanged="UserName_TextChanged"/>
                    <StackPanel HorizontalAlignment="Right" Height="1" Margin="0,0,0,0" Grid.Row="0" VerticalAlignment="Bottom" Width="160" Background="#61CE70"/>
                </StackPanel>
                <!--Create Password Field in the Seconde Row-->
                <Label x:Name="passwordlable" FlowDirection="RightToLeft" Grid.Row="1" Content="كلمة المرور" Foreground="Black" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                <PasswordBox x:Name="PasswordValue"  Grid.Row="1"  FontSize="16"  Height="20" Margin="0,0,119,5" Padding="0,0,0,0" BorderThickness="0" MaxLength="10" PasswordChanged="Password_PasswordChanged" />
                <StackPanel x:Name="sp1" HorizontalAlignment="Left" Height="1" Margin="0,30,110,0" Grid.Row="1" VerticalAlignment="Center" Width="160" Background="#61CE70" Visibility="Visible"/>
                <!--Create Show Password in the Seconde Row-->
                <TextBox x:Name="ShowPasswordUnmask"  Grid.Row="1"  FontSize="16"  Height="20" Margin="0,0,119,5" Padding="0,0,0,0" BorderThickness="0" MaxLength="10" Visibility="Hidden" TextChanged="ShowPasswordUnmask_TextChanged"/>
                <StackPanel x:Name="sp2" HorizontalAlignment="Left" Height="1" Margin="0,30,110,0" Grid.Row="1" VerticalAlignment="Center" Width="160" Background="#61CE70" Visibility="Hidden"/>
                <CheckBox Content="عرض" Grid.Row="2" x:Name="ShowHidPass" HorizontalAlignment="Right" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" Margin="0,0,106,0" Padding="0,0,0,0" VerticalAlignment="Bottom"  Visibility="Hidden" FontSize="14" Checked="ShowHidPass_Checked" Unchecked="ShowHidPass_Unchecked" Style="{DynamicResource ShowHidePassCheckBoxStyle}"/>
                <!--Create Login Button in the Seconde Row-->
                <Button x:Name="LoginButton" Grid.Row="3" Width="280" Height="30" Margin="0" Content="تسجيل الدخول"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" BorderBrush="#61CE70" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="LoginButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!--Create ForgetPassword TextBlock in the Seconde Row-->
                <TextBlock x:Name="ForgetPassword" Grid.Row="1" Text="هل نسيت كلمة المرور؟" FontFamily="Andalus" FontSize="16" Margin="390,189,87,14" MouseDown="ForgetPassword_MouseDown"/>
            </Grid>
            <!--Create footer-->
            <!--<Label Grid.Row="2" Content="Copyright 2023 FastMedia.One" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="13" Foreground="#54595F"/>-->
        </Grid>
    </Grid>
</Window>
