            <!-- Content view body-->
            <syncfusion:SfNavigationDrawer.ContentView>
                <Grid x:Name="mainContentView" 
                  Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <!--welcome Text-->
                        <StackPanel Background="White" 
                            Orientation="Horizontal" Grid.Column="0" Margin="0,4.5,0,0">
