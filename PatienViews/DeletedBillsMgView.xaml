<UserControl x:Class="HijamaClinicManagement.PatienViews.DeletedBillsMgView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HijamaClinicManagement.PatienViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White" FlowDirection="RightToLeft" Loaded="UserControl_Loaded">
    <!-- Create Deleted Bills Management Content-->
    <Grid   x:Name="DeletedBillManagementContent" Visibility="Visible" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="إدارة الفواتير المحذوفة" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20" Foreground="#FF5D5D61"/>
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <!-- Deleted Bills Management-->
            <DataGrid Grid.Row="2"  x:Name="DataViewPatient_DeletedBills" Visibility="Visible" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" Style="{DynamicResource DataGridStyle}">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                   Color="#61CE70"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn  Width="100"  Header="رقم سجل الفاتورة المحذوفة" Binding="{Binding DeletedBillRecId}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="رقم الملف" Binding="{Binding PatientFileNum}"  Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="رقم الفاتورة" Binding="{Binding BillId}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="150"  Header="تاريخ الاصدار" Binding="{Binding Path=BillDate, StringFormat='dd-MM-yyyy'}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="شريحة الدفع" Binding="{Binding PaymentChipType}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="خدمات اضافية" Binding="{Binding AdditionalServices}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="سعر الخدمات" Binding="{Binding PriceOfAdditionalServices}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="الجنسية" Binding="{Binding Nationality}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="الضريبة" Binding="{Binding Tax}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="الخصم" Binding="{Binding Discount}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="نوع الدفع" Binding="{Binding PaymentType}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="السعر الإجمالي المدفوع" Binding="{Binding TotalPricePaid}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="السداد" Binding="{Binding AmountRemainingUnpaid}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="100"  Header="اسم المدخل" Binding="{Binding EntryName}" Foreground="#FF5D5D61"/>
                    <DataGridTextColumn  Width="*"  Header="تاريخ الحذف" Binding="{Binding DeleteBillDate}" Foreground="#FF5D5D61"/>

                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Button For Clear Data-->
        <Button Grid.Row="2" x:Name="ClearButton_DBills"   Content="تفريغ الجدول"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Height="40" MaxWidth="250"  Margin="3" BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="ClearButton_DBills_Click"/>

    </Grid>
</UserControl>
