<UserControl x:Class="HijamaClinicManagement.ClinicManagementViews.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HijamaClinicManagement.ClinicManagementViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White" FlowDirection="RightToLeft" Loaded="UserControl_Loaded">
    <!--Create BackupContent -->
    <Grid   x:Name="BackupsContent" Visibility="Visible" Background="White">
        <Grid Grid.Row="1" x:Name="BackUpContentBody">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!-- Header in Row1-->
            <TextBlock x:Name="HeaderForBackupContent" Grid.Row="0" Text="نسخة احتياطية لقاعدة البيانات" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20" Foreground="#FF5D5D61" Padding="25,0,0,0"/>
            <!-- Create Fields in Row2-->
            <StackPanel Grid.Row="1" Orientation="Horizontal"   Margin="0,30,0,0" VerticalAlignment="Top">
                <TextBlock   Text="موقع الملف" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16"  Foreground="#FF5D5D61" VerticalAlignment="Center" Padding="10,0,0,0" Margin="20,0,0,0"/>
                <TextBox  x:Name="FileLocation" IsReadOnly="True" FontFamily="Arabic Typesetting" FontSize="16" Width="430" Height="40" Padding="0,10,0,0" Margin="10,0,0,0" Foreground="Black" FlowDirection="LeftToRight" Style="{StaticResource TextBoxStyle}"/>
                <Button x:Name="BrowseFile"  IsEnabled="False" Content="حدد الموقع"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Height="40" MinWidth="210"  Margin="3" BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="BrowseFile_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,20,0,0">
                <Button Grid.Row="1" x:Name="Backup"  IsEnabled="False" Content="نسخة احتياطية"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Height="40" MaxWidth="250"  Margin="3"  BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="Backup_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
