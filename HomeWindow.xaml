<Window x:Class="HijamaClinicManagement.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        xmlns:local="clr-namespace:HijamaClinicManagement"
        mc:Ignorable="d"
        Height="600" Width="800" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="White" AllowsTransparency="False" FlowDirection="RightToLeft" WindowState="Maximized" Loaded="Window_Loaded" ResizeMode="CanResizeWithGrip" MouseDown="Window_MouseDown">
    <!-- settings for view maximize window like chrome-->
    <WindowChrome.WindowChrome>
        <WindowChrome  GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" ResizeBorderThickness="7" CaptionHeight="0" />
    </WindowChrome.WindowChrome>
    <!-- Restyle Controls-->
    <Window.Resources>
        <!--Restyle NavigationItem -->
        <Style x:Key="NavigationItemPathStyle" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Fill" Value="#61CE70" />
        </Style>
        
        <!--Restyle syncfusion:GridHeaderCellControl-->
        <Style TargetType="syncfusion:GridHeaderCellControl" x:Key="headerStyle">
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="/WpfSideNav;component/Resources/Font/#Almarai"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="Width" Value="auto"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <!--Restyle syncfusion:CellControl-->
        <Style TargetType="syncfusion:GridCell" x:Key="customCellStyle">
            <Setter Property="Padding" Value="0,20,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
