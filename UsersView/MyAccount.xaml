<UserControl x:Class="HijamaClinicManagement.UsersView.MyAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HijamaClinicManagement.UsersView"
             mc:Ignorable="d" 
              d:DesignHeight="450" d:DesignWidth="800" Background="White" FlowDirection="RightToLeft" Loaded="UserControl_Loaded">
    <!--Create MyAccountManagemntContent  -->
    <Grid  x:Name="MyAccountManagemntContent" Visibility="Visible" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="HeaderForMyAccountManagemntContent" Grid.Row="0" Text="إدارة حسابي" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20" Foreground="#FF5D5D61" Padding="25,0,0,0"/>
        </StackPanel>
        <!--Create Row 2-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,40,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Button x:Name="AddPersonalImg_MyAccount"      Content="اضافة صورة"   FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16"  Height="40" MaxWidth="250"  Margin="3"  BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="AddPersonalImg_Click"/>
                <Button x:Name="EdieButton_MyAccount"          Content="تعديل"        FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16"  Height="40" MaxWidth="250"  Margin="3"  BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}"  Click="EdieButton_MyAccount_Click"/>
                <Button x:Name="DeletePersonalImg_MyAccount"   Content="حذف صورة"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16"  Height="40" MaxWidth="250"  Margin="3"  BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="DeletePersonalImg_Click"/>
            </StackPanel>
             <!-- Crate IMG-->
            <StackPanel  HorizontalAlignment="Left" Orientation="Vertical" VerticalAlignment="Top" Margin="30,60,30,0">

                <Rectangle x:Name="MyAccount_PersonalImg" Width="100" Height="100" Stroke="#76B82A">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/HijamaClinicManagement;component/Images/Background_user.png" Stretch="None"/>
                    </Rectangle.Fill>
                </Rectangle>

            </StackPanel>
            <!-- Crate Form User-->
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,30">
                <StackPanel   Orientation="Horizontal" Margin="0,12" Width="500">
                    <TextBlock   Text="اسم المستخدم" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Width="200" Foreground="#FF5D5D61" Padding="20,0,0,0"/>
                    <TextBox  Width="200" x:Name="UserNameField"  Height="40" FontFamily="Arabic Typesetting" FontSize="24" Foreground="Black" MaxLength="50" Padding="0,5" Style="{DynamicResource TextBoxStyle}"/>
                </StackPanel>
                <StackPanel  Orientation="Horizontal" Margin="0,10" Width="500">
                    <TextBlock   Text="كلمة المرور" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Width="200" Foreground="#FF5D5D61" Padding="20,0,0,0"/>
                    <TextBox Width="200"  Height="40" x:Name="PasswordField"  FlowDirection="LeftToRight" FontFamily="Arabic Typesetting" FontSize="24" MaxLength="50" Foreground="Black" Padding="5,5" Style="{DynamicResource TextBoxStyle}"/>
                </StackPanel>
                <StackPanel  Orientation="Horizontal" Margin="0,10" Width="500">
                    <TextBlock   Text="البريد الإلكتروني" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Width="200" Foreground="#FF5D5D61" Padding="20,0,0,0"/>
                    <TextBox Width="200"  Height="40" x:Name="EmailField"  FlowDirection="LeftToRight" FontFamily="Arabic Typesetting" FontSize="24" MaxLength="50"  Foreground="Black" Padding="0,5" Style="{DynamicResource TextBoxStyle}"/>
                </StackPanel>
                <StackPanel  Orientation="Horizontal" Margin="0,10" Width="500">
                    <TextBlock   Text="نوع المستخدم" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16" Width="200" Foreground="#FF5D5D61" Padding="20,0,0,0"/>
                    <TextBox Width="200" IsReadOnly="True" Height="40" x:Name="RoleField"  FlowDirection="LeftToRight" FontFamily="Arabic Typesetting" FontSize="24" Foreground="Black" Padding="0,5" Style="{DynamicResource TextBoxStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
