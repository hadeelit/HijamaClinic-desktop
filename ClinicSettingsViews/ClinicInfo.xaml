<UserControl x:Class="HijamaClinicManagement.ClinicSettingsViews.ClinicInfo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HijamaClinicManagement.ClinicSettingsViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="White" FlowDirection="RightToLeft" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderForClinicInfo" Grid.Row="0" Text="معلومات العيادة" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="20" Foreground="#FF5D5D61" Padding="25,0,0,0"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <!-- Create Buttons-->
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,0,0">
                <Button x:Name="AddButton_ClinicInfo"   Content="اضافة"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai"  Height="40" MaxWidth="250"  Margin="3" BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="AddButton_ClinicInfo_Click"/>
                <Button x:Name="DeleteButton_ClinicInfo"   Content="حذف"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai"  Height="40" MaxWidth="250" Margin="3" BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="DeleteButton_ClinicInfo_Click"/>
                <Button x:Name="EdieButton_ClinicInfo"   Content="تعديل"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai"  Height="40" MaxWidth="250" Margin="3" BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="EdieButton_ClinicInfo_Click"/>
                <Button x:Name="ClearButton_ClinicInfo"   Content="مسح"  FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai"    Height="40" MaxWidth="250"  Margin="3" BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="ClearButton_ClinicInfo_Click"/>
            </StackPanel>
            <!-- Create Form Fields-->
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="20,0,20,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Margin="0,10,0,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock   Text="اسم العيادة" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16"  Foreground="#FF5D5D61" Padding="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox  MinWidth="350"    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Height="30" x:Name="ClinicName"  FlowDirection="RightToLeft" TextWrapping="NoWrap"  Margin="20,0,0,0" Foreground="Black" Padding="0,5" Style="{DynamicResource TextBoxStyle}" />
                </StackPanel>
                <StackPanel  Orientation="Horizontal" Margin="0,10,0,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <TextBlock   Text="عنوان العيادة" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16"  Foreground="#FF5D5D61" Padding="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox  MinWidth="350"    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Height="30" x:Name="ClinicAddress"  FlowDirection="RightToLeft" TextWrapping="NoWrap"  Margin="10,0,0,0" Foreground="Black" Padding="0,5" Style="{DynamicResource TextBoxStyle}" />
                </StackPanel>
                <StackPanel  Orientation="Horizontal" Margin="0,10,0,12"  HorizontalAlignment="Stretch">
                    <TextBlock   Text="رقم الجوال" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" Margin="0,0,0,0" Foreground="#FF5D5D61" FontSize="16" Padding="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox MinWidth="350"  Height="30" x:Name="MobileNumField"  FlowDirection="RightToLeft"  Foreground="Black"  MaxLength="10" Margin="26,0,0,0" Style="{DynamicResource TextBoxStyle}" PreviewTextInput="NumberField_PreviewTextInput"/>
                </StackPanel>
                <StackPanel  HorizontalAlignment="Stretch" Orientation="Horizontal" Margin="0,10,0,12" >
                    <TextBlock   Text="رفع لوغو العيادة" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" Margin="0,0,0,0" Foreground="#FF5D5D61" FontSize="16" Padding="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle x:Name="LogoClinic" Width="100" Height="100" Stroke="#76B82A" Margin="70,0,0,0">
                    </Rectangle>
                    <Button x:Name="AddLogo_Clinic"  Content="تحميل"   FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16"  Height="40" Width="150"    BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="AddLogo_Clinic_Click" Margin="20,0,0,0"/>
                </StackPanel>
                <StackPanel  HorizontalAlignment="Stretch" Orientation="Horizontal" Margin="0,10,0,12" >
                    <TextBlock   Text="رفع ترويسة ملف الطباعة" FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" Margin="0,0,0,0" Foreground="#FF5D5D61" FontSize="16" Padding="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle x:Name="ClinicFileHeader" Width="100" Height="100" Stroke="#76B82A" Margin="10,0,0,0">
                    </Rectangle>
                    <Button x:Name="AddHeader_Clinic"  Content="تحميل"   FontFamily="/HijamaClinicManagement;component/Resources/Font/#Almarai" FontSize="16"  Height="40" Width="150"    BorderBrush="#76B82A" Background="{x:Null}"  Style="{DynamicResource ButtonStyle}" Click="AddHeader_Clinic_Click" Margin="20,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
